{
  "name": "blockout",
  "version": "5.1.0",
  "description": "Desktop previs tool for AI-native filmmaking — stage scenes, choreograph camera & character blocking with marks, export motion-reference packages for AI video generators.",
  "main": "out/main/index.js",
  "author": "Sam Wasserman",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src tests --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && playwright test tests/e2e/smoke.spec.ts",
    "e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:all": "npm run build && electron-builder -mwl --config electron-builder.yml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.7.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
